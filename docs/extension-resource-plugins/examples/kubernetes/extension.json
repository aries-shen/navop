{
  "schema_version": 1,
  "id": "com.navop.kubernetes",
  "name": "Navop Kubernetes Resource Provider",
  "version": "0.1.0",
  "description": "Reference IPC provider for Kubernetes resources, pod logs and events.",
  "engines": {
    "onetcli": ">=0.1.0"
  },
  "permissions": [
    "fs:read:~/.kube/config",
    "secrets:read:kubernetes.*",
    "spawn:./bin/kubernetes-provider",
    "ui:tab",
    "ui:notify",
    "ui:progress"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/kubernetes-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        }
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "kind": "kubernetes",
        "label": "Kubernetes",
        "secretNamespace": "kubernetes",
        "credentialReference": "kubeconfig"
      }
    ],
    "declarativePanels": [
      {
        "id": "kubernetes",
        "title": "Kubernetes",
        "runtimeId": "main",
        "template": "ui/main.html",
        "placement": "home_sidebar",
        "icon": "cluster",
        "activation": [
          "onConnectionKind:kubernetes"
        ]
      }
    ]
  }
}
