{
  "schema_version": 1,
  "id": "com.navop.docker",
  "name": "Navop Docker Resource Provider",
  "version": "0.1.0",
  "description": "Reference IPC provider for Docker containers, images and logs.",
  "engines": {
    "onetcli": ">=0.1.0"
  },
  "permissions": [
    "fs:read:/var/run/docker.sock",
    "fs:write:/var/run/docker.sock",
    "secrets:read:docker.*",
    "spawn:./bin/docker-provider",
    "ui:tab",
    "ui:notify",
    "ui:progress"
  ],
  "runtime": {
    "ipc": [
      {
        "id": "main",
        "entry": {
          "command": "./bin/docker-provider"
        },
        "transport": {
          "kind": "local_socket",
          "connect_timeout_ms": 5000
        }
      }
    ]
  },
  "contributes": {
    "connections": [
      {
        "kind": "docker",
        "label": "Docker",
        "secretNamespace": "docker"
      }
    ],
    "declarativePanels": [
      {
        "id": "docker",
        "title": "Docker",
        "runtimeId": "main",
        "template": "ui/main.html",
        "placement": "home_sidebar",
        "icon": "box",
        "activation": [
          "onConnectionKind:docker"
        ]
      }
    ]
  }
}
